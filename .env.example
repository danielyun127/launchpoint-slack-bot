# --- LaunchPoint MCP API (preferred — this is what your API key is for) ---
# IMPORTANT: rotate/regenerate this key in LaunchPoint's dashboard before using it
# for real, since the original was shared in a chat. Put only the NEW key here.
LAUNCHPOINT_MCP_URL=https://dashboard.launchpointhq.com/api/v1/mcp
LAUNCHPOINT_API_KEY=lp_pk_your_new_key_here
LAUNCHPOINT_CAMPAIGN_ID=8344cdc5-c1b2-4d12-ab04-44dacad85ec8

# --- Fallback: plain REST endpoint, only if you find one separate from MCP ---
LAUNCHPOINT_API_URL=

# --- Fallback: browser login, only needed if neither API works ---
LAUNCHPOINT_EMAIL=you@vocreations.com
LAUNCHPOINT_PASSWORD=your_password
LAUNCHPOINT_LOGIN_URL=https://dashboard.launchpointhq.com/login
LAUNCHPOINT_CAMPAIGN_URL=https://dashboard.launchpointhq.com/campaigns/8344cdc5-c1b2-4d12-ab04-44dacad85ec8/creators

# --- Slack ---
# Easiest: create an Incoming Webhook for the target channel
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Report ---
CLIENT_NAME=Krea
REPORT_TIMEZONE=America/Los_Angeles

# --- Budget ---
# Total campaign budget, plain number, no $ or commas. Update this whenever
# Krea sends more spend. If unset, the report skips the budget line.
KREA_TOTAL_BUDGET=100000

# --- Viral alerts (viral_alerts.py) ---
# Only videos posted on/after this date (Pacific) are alerted.
ALERT_START_DATE=2026-10-05

# --- micro1 (second client) ---
MICRO1_CAMPAIGN_ID=74bd7dae-02c3-4555-acf3-549b075c8b37
MICRO1_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Unique videos (a video cross-posted to several platforms counts once).
MICRO1_VIDEO_GOAL=600
# A video counts toward the goal once any of its posts reaches this many views.
MICRO1_MIN_VIEWS=1000
# Milestone alerts only for videos posted on/after this date (Pacific).
MICRO1_ALERT_START_DATE=2026-10-13
# Optional: lets the daily posts digest reply in the report's thread.
# Without these, the report goes through the webhook and the digest is
# posted as a separate message right after it.
MICRO1_SLACK_BOT_TOKEN=
MICRO1_SLACK_CHANNEL_ID=

# --- Tab (third client; webhook only) ---
TAB_CAMPAIGN_ID=4672889f-9932-4fdb-be0e-0a022a5efe7a
TAB_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Unique videos (same rules as micro1).
TAB_VIDEO_GOAL=750
TAB_MIN_VIEWS=1000
TAB_ALERT_START_DATE=2026-10-13
